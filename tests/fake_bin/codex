#!/usr/bin/env python3
"""测试用的假 Codex CLI。"""
import json
import os
import sys

args = sys.argv[1:]
log = os.environ.get("FAKE_LOG")
if log:
    with open(log, "a", encoding="utf-8") as f:
        f.write(json.dumps({"cli": "codex", "args": args, "cwd": os.getcwd(),
                            "api_key": "OPENAI_API_KEY" in os.environ}) + "\n")
if args == ["--version"]:
    print("codex-cli 0.80.0")
    sys.exit(0)
if args[:2] == ["login", "status"]:
    if os.environ.get("FAKE_AUTH") == "logged_out":
        sys.stderr.write("Not logged in\n")
        sys.exit(1)
    method = "API key" if os.environ.get("FAKE_AUTH") == "api_key" else "ChatGPT"
    sys.stderr.write("Logged in using %s\n" % method)
    sys.exit(0)
if not args or args[0] != "exec":
    sys.stderr.write("fake codex: expected exec\n")
    sys.exit(9)
for flag in ("--skip-git-repo-check", "--ephemeral"):
    if flag not in args:
        sys.stderr.write("fake codex: missing %s\n" % flag)
        sys.exit(9)
assert args[args.index("--sandbox") + 1] == "read-only"
assert args[args.index("--color") + 1] == "never"
assert args[-1] == "-", "prompt must come from stdin"
out = args[args.index("-o") + 1]
assert not os.path.isabs(out), "output path should be relative to cwd"
prompt = sys.stdin.read()
mode = os.environ.get("FAKE_MODE", "ok")
sys.stderr.write("[progress] thinking...\n")
if mode == "error":
    sys.stderr.write("ERROR: You've hit your usage limit. Try again later.\n")
    sys.exit(1)
with open(out, "w", encoding="utf-8") as f:
    f.write("GPT 收到，提示词共 %d 字。" % len(prompt))
print("final message")
if mode == "nonzero_with_reply":
    sys.exit(1)
