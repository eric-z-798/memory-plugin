#!/usr/bin/env python3
"""测试用的假 Claude Code：检查参数，按 FAKE_MODE 返回不同结果。"""
import json
import os
import sys
import time

args = sys.argv[1:]
log = os.environ.get("FAKE_LOG")
if log:
    with open(log, "a", encoding="utf-8") as f:
        f.write(json.dumps({"cli": "claude", "args": args, "cwd": os.getcwd(),
                            "api_key": "ANTHROPIC_API_KEY" in os.environ,
                            "claudecode": "CLAUDECODE" in os.environ}) + "\n")
if args == ["--version"]:
    print("2.1.0 (Claude Code)")
    sys.exit(0)
if args[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": os.environ.get("FAKE_AUTH") != "logged_out", "authMethod": os.environ.get("FAKE_AUTH", "claude.ai"), "email": "me@example.com"}))
    sys.exit(0)

required = ["-p", "--output-format", "--permission-mode", "--no-session-persistence", "--strict-mcp-config", "--tools"]
missing = [r for r in required if r not in args]
if missing:
    sys.stderr.write("fake claude: missing %s\n" % missing)
    sys.exit(9)
assert args[args.index("--output-format") + 1] == "json"
prompt = sys.stdin.read()
mode = os.environ.get("FAKE_MODE", "ok")
if mode == "sleep":
    with open(os.environ["FAKE_PIDFILE"], "w") as f:
        f.write(str(os.getpid()))
    time.sleep(60)
if mode == "error":
    print(json.dumps({"type": "result", "subtype": "success", "is_error": True,
                      "result": "Claude AI usage limit reached|1760000000"}))
    sys.exit(1)
if mode == "garbage":
    print("something went wrong")
    sys.exit(2)
reply = "Claude 收到，提示词共 %d 字。\n\n<<<STATUS\n{\"summary\": \"测试\", \"votes\": []}\nSTATUS>>>" % len(prompt)
print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": reply,
                  "session_id": "s", "total_cost_usd": 0}, ensure_ascii=False))
if mode == "nonzero_with_reply":
    sys.exit(1)
